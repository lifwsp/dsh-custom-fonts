{
  "name": "dsh-custom-fonts",
  "version": "1.2.0",
  "description": "Customize Latin and CJK UI fonts, code fonts, and font sizes in DeepSeek Harness, with live previews and automatic saving.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "font",
    "fonts",
    "font-size",
    "code font",
    "chinese",
    "english",
    "ui",
    "latin",
    "cjk",
    "japanese",
    "korean",
    "monospace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifwsp/dsh-custom-fonts.git"
  },
  "homepage": "https://github.com/lifwsp/dsh-custom-fonts#readme",
  "bugs": {
    "url": "https://github.com/lifwsp/dsh-custom-fonts/issues"
  },
  "contributors": [
    "AgustD (https://github.com/lsh2002) - original author",
    "tom613951 (https://github.com/tom613951) - settings persistence (PR #1)"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
